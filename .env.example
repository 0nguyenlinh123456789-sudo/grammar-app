# Upstash Redis connected from the Vercel Marketplace
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-standard-rest-token

# Use two different random secrets. Never expose them through VITE_* variables.
ACCESS_SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_ADMIN_SECRET=replace-with-at-least-24-random-characters

# HOW CUSTOMERS ORDER. Set at least ONE of these four or the pricing buttons
# have nowhere to send the order — the live build shipped with all four empty,
# so "MUA PREMIUM" copied a message the buyer could not send to anybody.
# The app shows every channel that is set; it says so plainly when none is.
# Checkout page / sales form opened directly when the buyer clicks a plan
VITE_SALES_URL=
# Zalo: either a phone number (0901234567) or a full zalo.me group link
VITE_SALES_ZALO=
VITE_SALES_EMAIL=
VITE_SALES_PHONE=

# CHUYỂN KHOẢN NGÂN HÀNG. Chủ dự án đã chọn: CHẤP NHẬN lộ TÊN chủ tài khoản (mọi
# chuyển khoản ở VN đều hiện tên đó cho người trả), KHÔNG lộ thứ gì khác — nên ở
# đây tuyệt đối KHÔNG thêm số điện thoại, địa chỉ hay email cá nhân.
#
# Phải có CẢ HAI cái đầu thì khối chuyển khoản mới hiện; thiếu một cái thì app
# BÁO là chưa có thông tin chuyển khoản, chứ không hiện một nửa dùng không được.
#
# ⚠️⚠️ BỐN BIẾN NÀY CỐ Ý KHÔNG CÓ TIỀN TỐ `VITE_` — ĐỪNG THÊM VÀO.
# Vite nhúng thẳng mọi biến `VITE_*` vào JavaScript công khai lúc dựng, nên đặt
# `VITE_BANK_ACCOUNT` nghĩa là số tài khoản nằm sẵn trong tệp tĩnh, ai mở
# DevTools cũng đọc được, kể cả người chưa bấm mua. Bốn biến dưới đây chỉ máy chủ
# đọc; client phải gọi POST /api/access {action:'bank'} mới có, và lệnh đó có
# giới hạn tốc độ. Đặt trên Vercel như biến thường (KHÔNG tick "expose to browser").
BANK_NAME=
BANK_ACCOUNT=
# Tên chủ tài khoản (tùy chọn, để khách đối chiếu trước khi bấm chuyển)
BANK_HOLDER=
# Ảnh QR — KHÔNG đặt file vào public/ nữa (thư mục đó vào Git và ai cũng tải được).
# Dán thẳng chuỗi data URI: data:image/png;base64,iVBORw0KG...
# Đổi ảnh sang Base64 bằng PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("qr.png"))
# ⚠️ QR lấy từ app ngân hàng là QR TĨNH — nó KHÔNG mang số tiền và KHÔNG mang nội
# dung, nên khách vẫn phải tự gõ mã đơn vào nội dung. App đã nói rõ điều đó.
# Không đặt cũng được: khối vẫn chạy đủ bằng số tài khoản gõ tay.
BANK_QR=

# GIÁ TỪNG GÓI — TÙY CHỌN. Giá đã có sẵn trong src/utils/goi.js (99.000 /
# 399.000 / 599.000đ) nên web bán được ngay mà không cần đặt gì. Ba biến này
# chỉ để GHI ĐÈ khi muốn đổi giá mà không sửa mã.
#
# Ghi bằng SỐ ĐỒNG: 350000 hoặc 350.000đ đều đọc được. Gõ thứ không đọc được
# (chữ, số âm, dưới 1.000đ) thì bị BỎ QUA và giữ giá mặc định — bảng giá rao
# "5đ" vì lỡ gõ "-5" thì tệ hơn nhiều so với giữ giá cũ.
#
# ⚠️ Cùng cái bẫy với VITE_SALES_*: VITE_* nhúng LÚC DỰNG, nên đặt biến trên
# Vercel mà không DEPLOY LẠI thì bản live vẫn dùng giá cũ.
VITE_PRICE_1M=
VITE_PRICE_6M=
VITE_PRICE_12M=

# Key Gemini chỉ để CHẠY `npm run ai:that` (gọi Google thật, kiểm tính năng AI).
# ⚠️ KHÔNG đặt tên có tiền tố VITE_: biến VITE_* bị nhúng vào bundle và đi tới
# trình duyệt của MỌI khách. Đây là biến chỉ dùng ở máy dev, không đặt trên Vercel.
GEMINI_TEST_KEY=

# Set to 1 to exercise the real access-code screen while running `npm run dev`.
# Leave empty for the usual developer bypass.
VITE_FORCE_ACCESS_GATE=

# No GEMINI_API_KEY here on purpose: the AI features are bring-your-own-key.
# Every learner pastes their own Google AI Studio key in the app
# (menu "KHÓA AI (API KEY)"), it is stored in their browser and forwarded per
# request. The server never holds a shared provider credential.
